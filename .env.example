# ──────────────────────────────────────────────
# dsh-passwords 配置文件（复制为 .env 后生效）
# 一键安装（install.sh）会自动生成含随机 SETUP_KEY 的 .env，
# 手动安装才需要看这个文件。
# ──────────────────────────────────────────────

# 首次配置密钥（必填）：install.sh 自动生成；手动安装用 openssl rand -hex 24 生成。
# 作用：第一次打开网页创建主用户时校验用；JWT 会话密钥也由它派生，安装后不要改。
SETUP_KEY=change-me-to-a-strong-random-key

# 会话签名密钥（强烈建议生产环境独立设置，与 SETUP_KEY 解耦）：
# 留空则从 SETUP_KEY 派生；一旦泄漏 SETUP_KEY，攻击者就能伪造任意用户会话。
# 用 openssl rand -hex 32 生成；设置后不要随意更换（旧会话会全部失效）。
MCP_JWT_SECRET=

# ── 数据库 ──────────────────────────────────
# sqlite（默认）或 mysql。SQLite 可自动建库；MySQL 8 数据库需预先创建。
DSH_PASSWORDS_DB_DRIVER=sqlite
# SQLite 数据库文件；MySQL 模式下仍作为 ACME、配对占位目录等本地状态的根路径。
# 相对路径以本 .env 所在目录为基准（不受 systemd WorkingDirectory 影响）。
MCP_DB_PATH=./data/platform.db
# MySQL 模式专用。建议使用独立数据库和仅对该数据库有权限的专用账号。
DSH_PASSWORDS_MYSQL_HOST=
DSH_PASSWORDS_MYSQL_PORT=3306
DSH_PASSWORDS_MYSQL_USER=
DSH_PASSWORDS_MYSQL_PASSWORD=
DSH_PASSWORDS_MYSQL_DATABASE=dsh_passwords
# off / required / verify-ca；verify-ca 还必须提供 CA 文件。
DSH_PASSWORDS_MYSQL_TLS=off
DSH_PASSWORDS_MYSQL_TLS_CA=
DSH_PASSWORDS_MYSQL_QUERY_TIMEOUT_MS=15000
# 数据静态加密密钥（可选）：openssl rand -hex 32 生成。
# 留空则从 SETUP_KEY 派生；一旦设置就不能再换，否则旧数据无法解密。
MCP_DB_ENC_KEY=

# ── 子用户宿主机专属工作区 ──────────────────
# 新增子用户时自动创建 u<用户ID> 子目录并注册为其专属工作区；若有保留目录则自动换安全后缀。
# 留空默认使用当前运行账号主目录下的 dsh-user-workspaces；不要放进数据库 data 目录。
# 相对路径以本 .env 所在目录为基准。
MCP_MANAGED_WORKSPACE_ROOT=

# ── 网关监听 ────────────────────────────────
MCP_GATEWAY_HOST=0.0.0.0
# 网关端口：自动 HTTPS 下默认 443（需 root 绑定）
MCP_GATEWAY_PORT=443
# dsh 网页地址（插件自动指向 dsh 实际端口，一般不用改）
MCP_GATEWAY_UPSTREAM=http://127.0.0.1:3080
# 80 端口：ACME 证书验证 + 301 跳转 HTTPS
MCP_GATEWAY_REDIRECT_PORT=80
# 公网访问地址（跳转固定用它，防 Host 反射）；留空自动判断
MCP_GATEWAY_PUBLIC_HOST=

# ── 用户本机工作区助手 ──────────────────────
# 本机助手 WebSocket 监听地址；局域网用户连接服务器时保持 0.0.0.0。
MCP_LOCAL_WORKSPACE_HOST=0.0.0.0
# 本机助手端口；留空时使用 MCP_GATEWAY_PORT + 1。
MCP_LOCAL_WORKSPACE_PORT=
# 浏览器生成配对命令时使用的完整 ws:// 或 wss:// 地址；反向代理/NAT 下建议显式设置。
MCP_LOCAL_WORKSPACE_PUBLIC_URL=
# 本机助手注册工作区的稳定占位目录；不要指向随版本切换的 release/current 目录
MCP_LOCAL_WORKSPACE_PLACEHOLDER_ROOT=

# ── 自动 HTTPS（Let's Encrypt，零配置） ─────
# 自己的域名（A 记录指向本机后填这里）；留空自动用 <公网IP>.sslip.io
MCP_GATEWAY_DOMAIN=
# 自动 HTTPS 开关：留空=自动开启；0=false=关闭（明文 HTTP，危险）
MCP_GATEWAY_AUTO_TLS=
# 证书到期提醒邮箱（可选）
MCP_GATEWAY_ACME_EMAIL=
# 1=使用 LE 测试环境签发（仅调试用，浏览器不信任）
MCP_GATEWAY_ACME_STAGING=

# ── 自备证书（可选，两个都填时优先于自动 HTTPS） ──
MCP_GATEWAY_TLS_CERT=
MCP_GATEWAY_TLS_KEY=

# ── dsh 相关 ────────────────────────────────
# dsh 安装目录（@deepseek-ai/dsh 所在处）；留空自动探测（npm root -g）
MCP_DSH_ROOT=
# 重载补丁后自动重启的 dsh systemd 服务名；留空则不自动重启
MCP_DSH_RESTART_SERVICE=dsh-web
# dsh 设置文件路径（网关与 dsh 不在同一台机器时才需要）
MCP_DSH_SETTINGS_FILE=
# 手动指定 .env 路径（插件自动传，一般不用填）
DSH_PASSWORDS_ENV_FILE=
