# dsh-passwords Docker Compose 环境变量（复制为 .env 后填写）
# dsh 的模型密钥（必填）：https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 对外公开主机名（可选）：登录链接等对外地址用它拼接；留空则按请求头推断
MCP_GATEWAY_PUBLIC_HOST=

# Owner-configured third-party SSH WebSocket endpoints (comma-separated).
# Subusers need the SSH permission toggle to use them. Standard dsh-ssh is
# detected automatically when installed.
MCP_GATEWAY_SSH_WS_ENDPOINTS=

# Bundled DSH version (optional; defaults to the release baseline)
#DSH_VERSION=0.1.5-rc.1
